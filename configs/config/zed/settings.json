// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "sticky_scroll": {
    "enabled": true
  },
  "session": {
    "trust_all_worktrees": false
  },
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "right",
  },
  "context_servers": {
    "mcp-server-sequential-thinking": {
      "enabled": false,
      "remote": false,
      "settings": {},
    },
    "mcp-custom-notion": {
      "enabled": true,
      "url": "https://mcp.notion.com/mcp"
    },
    "mcp-custom-socket": {
      "enabled": false,
      "url": "https://mcp.socket.dev/",
      // "url": "https://mcp.socket-staging.dev/",
      //"headers": { "Authorization": "REDACTED" }
    },
    "mcp-custom-linear": {
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "mcp-custom-github": {
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": {
        "client_id": "REDACTED"
      }
    },
    "mcp-custom-sentry": {
      "enabled": true,
      "url": "https://mcp.sentry.dev/mcp"
    },
    "mcp-context7": {
      "enabled": true,
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "mcp-server-brave-search": {
      "enabled": true,
      "remote": false,
      "settings": {
        "brave_api_key": "REDACTED",
      },
    },
    "postgres-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {
        "database_url": "REDACTED",
      },
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access"
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "claude-fable-5[1m]",
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "code_lens": "on",
  "colorize_brackets": true,
  "format_on_save": "off",
  "audio": {
    "experimental.auto_microphone_volume": true,
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },
  "ensure_final_newline_on_save": true,
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "thumb_border": "full",
    "current_line_highlight": "all",
  },
  "agent": {
    "play_sound_when_agent_done": "always",
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": [
        "zed.dev",
        "sum.golang.org",
        "proxy.golang.org",
        "sum.golang.google.cn",
        "raw.githubusercontent.com",
        "htmx.org",
        "api.github.com"
      ]
    },
    "dock": "left",
    "default_profile": "write",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "\\bsudo\\b",
            },
            {
              "pattern": "\\bgit\\s+push\\b",
            },
            {
              "pattern": "\\brm\\b",
            },
          ],
        },
        "delete_path": {
          "default": "confirm",
        },
      },
    },
    "default_model": {
      "effort": "high",
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
      "format_on_save": "off",
      "soft_wrap": "editor_width",
      "wrap_guides": [80],
    },
    "JavaScript": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "..."],
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "..."],
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "..."],
    },
  },
  "theme": {
    "mode": "system",
    "light": "Tron Legacy Light",
    "dark": "Tron Legacy",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "calls": {
    "mute_on_join": true,
    "share_on_join": false,
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    // "background_coloring": "indent_aware"
  },
  "tab_size": 2,
  "terminal": {
    "option_as_meta": true,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all",
  },
  "buffer_font_family": "SF Mono",
  "telemetry": {
    "metrics": true,
    "diagnostics": true,
  },
  "ui_font_size": 16,
  "lsp": {
    "jsonnet-language-server": {
      "settings": {
        "resolve_paths_with_tanka": true,
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
          "tsserver": { "maxTsServerMemory": 16184 },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
          "tsserver": { "maxTsServerMemory": 16184 },
        },
      },
    },
  },
}
